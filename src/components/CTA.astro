---
import Icon from './Icon.astro';
const { title = 'Your surplus. Your next opportunity.', text = 'Tell us what’s in stock. Let’s put a plan in motion.' } = Astro.props;
---
<section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow light">LET’S MOVE FORWARD</span><h2>{title}</h2><p>{text}</p></div><a class="button button-white" href="/contact/?cl=Bottom%20CTA">Discuss your inventory <Icon name="diagonal" /></a></div><div class="cta-orbit" aria-hidden="true"></div></section>
