---
const steps = [
  ['Share your company’s stock', 'Introduce your business and role, then share the category, quantity, condition and locations.'],
  ['Review the lot together', 'Your inventory or operations team helps confirm what is available and who can approve the sale.'],
  ['Agree the details', 'Work out the commercial terms and next steps directly with our team.'],
  ['We arrange pickup', 'Our own logistics collects the agreed goods, anywhere in India.'],
];
---
<div class="steps">{steps.map(([title, text], i) => <div class="step"><div class="step-num">0{i + 1}</div><h3>{title}</h3><p>{text}</p></div>)}</div>
