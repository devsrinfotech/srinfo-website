---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
---
<article class="article-card" data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.category}`.toLowerCase()}>
  <a href={`/insights/${post.id}/`} tabindex="-1" aria-hidden="true"><img src={`/images/${post.data.image}.webp`} srcset={`/images/${post.data.image}-small.webp 640w, /images/${post.data.image}.webp 1200w`} sizes="(max-width: 767px) 92vw, 30vw" alt="" width="1200" height="800" loading="lazy" decoding="async" /></a>
  <div class="article-meta"><span class="tag">{post.data.category}</span><span>·</span><span>{post.data.readingTime} min read</span></div>
  <h3><a href={`/insights/${post.id}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={`/insights/${post.id}/`} aria-label={`Read the insight: ${post.data.title}`}>Read the insight <Icon name="diagonal" size={16} /></a>
</article>
