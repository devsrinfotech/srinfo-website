---
import Icon from './Icon.astro';
interface Props { items: { question: string; answer: string }[]; title?: string }
const { items, title = 'Good questions. Clear answers.' } = Astro.props;
---
<section class="section faq-section"><div class="container faq-layout"><div><span class="eyebrow">A LITTLE MORE CLARITY</span><h2>{title}</h2><p>Have a specific lot in mind?<br /><a class="text-link" href="/contact/">Let’s talk through it <Icon size={16} /></a></p></div><div class="faq-list">{items.map(item => <details><summary>{item.question}<Icon name="plus" size={19} /></summary><p>{item.answer}</p></details>)}</div></div></section>
