---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Steps from '../components/Steps.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories, solutions, faqs } from '../data/business';
import { getCollection } from 'astro:content';
import { isPublished, newestFirst } from '../lib/content.mjs';
const posts = (await getCollection('blog', ({data}) => isPublished(data))).sort(newestFirst).slice(0,3);
const descriptions = ['From end-of-season collections to excess size runs. Give your stock its next chapter.', 'Kitchenware, home essentials and surplus ranges. More possibilities beyond the shelf.', 'Overstock, open-box and untested returns. A buying conversation built around your lot.'];
const solutionDescriptions = ['Clear space for your next move. We buy excess, slow-moving and end-of-season stock in bulk.', 'Turn accumulated returns into a new opportunity. Share your mixed or category-specific return lots.', 'A damaged box or label doesn’t have to be the end of the story. Let’s review the opportunity.'];
---
<BaseLayout title="Surplus Inventory & Liquidation Buyers in India | SR Infotech" description="Turn surplus stock into opportunity. SR Infotech buys bulk apparel, home, kitchen and electronics inventory, with its own pickup logistics across India.">
  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <div class="hero-pill"><span class="status-dot"></span> SURPLUS INVENTORY BUYERS. PAN-INDIA PICKUP.</div>
        <h1>Your surplus.<br /><span class="accent">New possibilities.</span><br /><span class="light-line">Let’s move it.</span></h1>
        <p>SR Infotech buys bulk surplus stock, ecommerce returns and clearance inventory across India. Apparel, home & kitchen, electronics—with our own pickup logistics. Unlock value. Move forward.</p>
        <div class="hero-actions"><a class="button" href="/contact/?cl=Homepage%20Hero">Sell your inventory <Icon name="diagonal" size={20} /></a><a class="text-link" href="/how-it-works/">See how it works <Icon size={17} /></a></div>
        <div class="hero-proof"><span><Icon name="check" size={14} /> Direct bulk buying</span><span><Icon name="check" size={14} /> Our own pickup logistics</span></div>
      </div>
      <div class="hero-art">
        <img class="hero-image" src="/images/hero.webp" srcset="/images/hero-small.webp 640w, /images/hero.webp 1200w" sizes="(max-width: 767px) 90vw, 45vw" alt="Illustrative bulk apparel, kitchenware and electronics beside open cartons and palletised inventory" width="1200" height="1200" fetchpriority="high" />
        <div class="floating-note note-top"><div class="icon-badge"><Icon name="repeat" /></div><div><strong>Value, back in motion.</strong><span>A smarter future for surplus</span></div></div>
        <div class="floating-note note-bottom"><div class="icon-badge"><Icon name="truck" /></div><div><strong>Your stock. Our pickup.</strong><span>Own logistics · Across India</span></div></div>
      </div>
    </div>
  </section>
  <div class="audience-band"><div class="container audience-inner"><span class="audience-label">Built for businesses.<br />Ready for your inventory.</span><div class="audience-items"><span><Icon name="box" /> Ecommerce businesses</span><span><Icon name="layers" /> Retail brands</span><span><Icon name="globe" /> Multi-location enterprises</span></div></div></div>
  <section class="section"><div class="container intro-layout"><div><span class="eyebrow">A NEW PERSPECTIVE ON INVENTORY</span><h2>Stock that’s standing still.<br />A business that isn’t.</h2></div><div><p>A season ends. A product range changes. Returns build up. Your inventory shouldn’t hold back what comes next.</p><p>SR Infotech buys bulk surplus inventory across India. We connect a clear buying decision with our own pickup logistics, helping your team move from excess stock to its next opportunity.</p><a href="/about/" class="text-link">Get to know SR Infotech <Icon name="diagonal" size={17} /></a></div></div></section>
  <section class="section category-section" id="what-we-buy"><div class="container">
    <div class="section-heading"><div><span class="eyebrow">WHAT WE BUY</span><h2>Three categories.<br />Countless opportunities.</h2></div><p>From fashion floors to fulfilment centres, we see the potential in your surplus.</p></div>
    <div class="category-grid">{categories.map((category, i) => <a class="category-card" href={`/categories/${category.slug}/`}><div class="category-image"><img src={`/images/${category.image}.webp`} srcset={`/images/${category.image}-small.webp 640w, /images/${category.image}.webp 1200w`} sizes="(max-width: 767px) 92vw, 30vw" alt={category.imageAlt} width="1200" height="800" loading="lazy" decoding="async" /><span class="category-index">0{i + 1}</span></div><div class="category-copy"><h3>{category.name}<Icon name="diagonal" size={22} /></h3><p>{descriptions[i]}</p><span class="category-tag">{i === 0 ? 'SEASONAL · SURPLUS · RETURNS' : i === 1 ? 'OVERSTOCK · CLEARANCE · OPEN-BOX' : 'SURPLUS · RETURNS · UNTESTED'}</span></div></a>)}</div>
  </div></section>
  <section class="section solutions-section"><div class="container"><div class="section-heading"><div><span class="eyebrow light">WHEN INVENTORY NEEDS A NEW DIRECTION</span><h2>Whatever the backstory,<br />let’s talk about what’s next.</h2></div><p>Different inventory challenges. One direct conversation with a bulk buyer.</p></div><div class="solution-grid">{solutions.map((solution,i) => <div class="solution-card"><Icon name={solution.icon} /><h3>{solution.name}</h3><p>{solutionDescriptions[i]}</p><a class="text-link" href={`/${solution.slug}/`}>Explore this opportunity <Icon name="diagonal" size={16} /></a></div>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">A CLEAR WAY FORWARD</span><h2>From your warehouse<br />to your next chapter.</h2></div><a class="text-link" href="/how-it-works/">How we work together <Icon name="diagonal" size={18} /></a></div><Steps /></div></section>
  <section class="section" style="padding-top:0"><div class="container coverage-panel"><div class="coverage-copy"><span class="eyebrow">LOCAL CONVERSATIONS. NATIONAL REACH.</span><h2>Wherever your stock is,<br />we can pick it up.</h2><p>Your inventory can be in one location or spread across the country. Our own logistics gives your business a route to pickup across India.</p><a class="text-link" href="/contact/?cl=Pan-India%20Pickup">Let’s discuss your locations <Icon name="diagonal" size={18} /></a></div><div class="coverage-graphic" aria-label="Own logistics for pan-India inventory pickup"><div class="orbit"></div><div class="orbit"></div><div class="orbit"></div><div class="coverage-center"><Icon name="globe" size={46} /><strong>Pan-India pickup</strong></div><div class="coverage-chip"><span class="status-dot"></span> Your warehouses</div><div class="coverage-chip"><span class="status-dot"></span> Your retail network</div><div class="coverage-chip"><span class="status-dot"></span> Your fulfilment centres</div><div class="coverage-chip"><span class="status-dot"></span> Our own logistics</div></div></div></section>
  {posts.length > 0 && <section class="section insights-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">THE INVENTORY PERSPECTIVE</span><h2>Better informed.<br />Better positioned.</h2></div><a href="/insights/" class="text-link">Explore all insights <Icon name="diagonal" size={18} /></a></div><div class="article-grid">{posts.map(post => <ArticleCard post={post} />)}</div></div></section>}
  <FAQ items={faqs} />
  <CTA />
</BaseLayout>
