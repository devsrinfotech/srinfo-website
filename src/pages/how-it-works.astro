---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Steps from '../components/Steps.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { faqs } from '../data/business';
---
<BaseLayout title="How to Sell Bulk Surplus Inventory | SR Infotech" description="Share your stock, discuss a bulk purchase and arrange pan-India pickup with SR Infotech. A direct buying process for brands and ecommerce businesses.">
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{name:'How it works'}]} /><span class="eyebrow">FROM SURPLUS TO WHAT’S NEXT</span><h1>Your inventory.<br />A clear way forward.</h1><p>One direct conversation, from the first stock details to the pickup. We keep the process focused on your business and your lot.</p><a href="/contact/?cl=Process" class="button">Start a buying conversation <Icon name="diagonal" /></a></div></section>
  <section class="section"><div class="container"><span class="eyebrow">FOUR STEPS. ONE CONNECTED PROCESS.</span><h2>Let’s get your stock moving.</h2><Steps /></div></section>
  <section class="section insights-section"><div class="container split-content"><div><span class="eyebrow">READY WHEN YOU ARE</span><h2>You don’t need a perfect presentation.</h2><p>A basic stock overview is enough to start. If you already have a detailed stock list, let us know and we’ll arrange how to share it.</p><a class="text-link" href="/insights/prepare-surplus-stock-list/">Read our stock-list guide <Icon name="diagonal" size={18} /></a></div><div><ul class="check-list">{['Product category and approximate quantity', 'Known condition, including untested or damaged stock', 'Warehouse or pickup location', 'Your company and the best way to reach you'].map(text => <li><Icon name="check" size={18} />{text}</li>)}</ul><p class="info-note">Pricing, payment and transaction details are discussed directly with your team. Your lot gets a conversation of its own.</p></div></div></section>
  <FAQ items={faqs.slice(2)} />
  <CTA />
</BaseLayout>
