---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Steps from '../components/Steps.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { faqs } from '../data/business';
---
<BaseLayout title="How to Sell Bulk Surplus Inventory | SR Infotech" description="Share your stock, discuss a bulk purchase and arrange pan-India pickup with SR Infotech. A direct buying process for brands and ecommerce businesses.">
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{name:'How it works'}]} /><span class="eyebrow">DIRECT FROM YOUR TEAM</span><h1>From your stock review<br />to an agreed pickup.</h1><p>Our buying process starts with the business that owns the inventory. Your warehouse, returns or operations team can open the conversation and involve the person responsible for approving the sale.</p><a href="/contact/?cl=Process" class="button">Start a buying conversation <Icon name="diagonal" /></a></div></section>
  <section class="section"><div class="container"><span class="eyebrow">FOUR STEPS. ONE CONNECTED PROCESS.</span><h2>Let’s get your stock moving.</h2><Steps /></div></section>
  <section class="section insights-section"><div class="container split-content"><div><span class="eyebrow">READY WHEN YOU ARE</span><h2>A clear overview is enough to start.</h2><p>Your team can contact us while preparing a stock list. Distinguish quantities still under review from stock approved for sale, and mention any brand or channel restrictions.</p><a class="text-link" href="/insights/prepare-surplus-stock-list/">Read our stock-list guide <Icon name="diagonal" size={18} /></a></div><div><ul class="check-list">{['Stock-owning company and your role or team', 'Product category and approximate quantity', 'Known condition, including untested or damaged stock', 'Warehouse or pickup locations', 'Release status and the person responsible for approval'].map(text => <li><Icon name="check" size={18} />{text}</li>)}</ul><p class="info-note">Pricing, payment and transaction details are discussed directly with your team. Your lot gets a conversation of its own.</p></div></div></section>
  <FAQ items={faqs.slice(2)} />
  <CTA />
</BaseLayout>
