---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import RelatedInsights from '../components/RelatedInsights.astro';
import { solutions } from '../data/business';
import { site } from '../data/site';
export function getStaticPaths() { return solutions.map(solution => ({ params: { solution: solution.slug }, props: { solution } })); }
const { solution } = Astro.props;
---
<BaseLayout title={`${solution.name} Buyers in India | SR Infotech`} description={solution.description} schema={{ '@type': 'Service', name: solution.name + ' buying', provider: { '@id': `${site.url}/#organization` }, areaServed: 'India', description: solution.description }}>
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{ name: solution.name }]} /><span class="eyebrow">{solution.name} · SR INFOTECH</span><h1>{solution.title}</h1><p>{solution.intro}</p><a class="button" href={`/contact/?cl=${encodeURIComponent(solution.name)}`}>Tell us about your stock <Icon name="diagonal" /></a></div></section>
  <section class="section"><div class="container"><div class="editorial-sections">{solution.paragraphs.map(([title, text]) => <div class="editorial-row"><h2>{title}</h2><p>{text}</p></div>)}<div class="editorial-row"><h2>Across the categories that matter.</h2><p>Explore our buying focus in <a class="text-link" href="/categories/apparel/">apparel</a>, <a class="text-link" href="/categories/footwear/">footwear</a>, <a class="text-link" href="/categories/home-kitchen/">home & kitchen</a> and <a class="text-link" href="/categories/electronics/">electronics</a>. Every lot starts with its own conversation.</p></div></div></div></section>
  <FAQ items={solution.faqs} title="Understand your options." />
  <RelatedInsights />
  <CTA />
</BaseLayout>
