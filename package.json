    "astro": "^6.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0"
  }
}
